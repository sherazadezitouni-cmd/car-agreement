{% comment %}
  Product Grid Section - Displays collection products with filtering and sorting
{% endcomment %}

{%- liquid
  assign collection = collections[section.settings.collection] | default: collections.all
  assign products_per_page = section.settings.products_to_show
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = section.settings.columns_tablet
  assign columns_mobile = section.settings.columns_mobile
  assign show_filters = section.settings.show_filters
  assign enable_sorting = section.settings.enable_sorting
  assign enable_quick_view = section.settings.enable_quick_view
-%}

<section class="product-grid" data-section-id="{{ section.id }}" data-section-type="product-grid">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="product-grid__container">
      {% if show_filters and collection.all_tags.size > 0 %}
        {%- comment -%} Filter Sidebar (Desktop) / Drawer (Mobile) {%- endcomment -%}
        <aside class="product-grid__filters" id="product-filters">
          <div class="filters__header">
            <h3 class="filters__title">{{ 'collections.filters.title' | t }}</h3>
            <button type="button" class="filters__clear" id="clear-filters">
              {{ 'collections.filters.clear_all' | t }}
            </button>
          </div>

          <div class="filters__content">
            {%- comment -%} Filter by Tags {%- endcomment -%}
            <div class="filter-group">
              <h4 class="filter-group__title">{{ 'collections.filters.category' | t }}</h4>
              <ul class="filter-list">
                {% for tag in collection.all_tags %}
                  <li class="filter-item">
                    <label class="filter-checkbox">
                      <input type="checkbox" name="tag" value="{{ tag | handle }}" {% if current_tags contains tag %}checked{% endif %}>
                      <span>{{ tag }}</span>
                    </label>
                  </li>
                {% endfor %}
              </ul>
            </div>

            {%- comment -%} Price Range Filter {%- endcomment -%}
            <div class="filter-group">
              <h4 class="filter-group__title">{{ 'collections.filters.price' | t }}</h4>
              <div class="price-range">
                <input type="range" id="price-min" min="0" max="500" value="0" step="10">
                <input type="range" id="price-max" min="0" max="500" value="500" step="10">
                <div class="price-range__labels">
                  <span id="price-min-label">$0</span>
                  <span id="price-max-label">$500+</span>
                </div>
              </div>
            </div>
          </div>

          <button type="button" class="btn btn--primary btn--full filters__apply">
            {{ 'collections.filters.apply' | t }}
          </button>
        </aside>
      {% endif %}

      <div class="product-grid__main">
        {% if enable_sorting or show_filters %}
          <div class="product-grid__toolbar">
            {% if show_filters %}
              <button type="button" class="btn btn--secondary filters__toggle" aria-label="{{ 'collections.filters.toggle' | t }}">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="4" y1="6" x2="16" y2="6"></line>
                  <line x1="4" y1="10" x2="16" y2="10"></line>
                  <line x1="4" y1="14" x2="16" y2="14"></line>
                </svg>
                {{ 'collections.filters.title' | t }}
              </button>
            {% endif %}

            {% if enable_sorting %}
              <div class="product-grid__sort">
                <label for="sort-by">{{ 'collections.sorting.title' | t }}:</label>
                <select id="sort-by" name="sort_by" class="sort-select">
                  <option value="manual">{{ 'collections.sorting.featured' | t }}</option>
                  <option value="best-selling">{{ 'collections.sorting.best_selling' | t }}</option>
                  <option value="title-ascending">{{ 'collections.sorting.az' | t }}</option>
                  <option value="title-descending">{{ 'collections.sorting.za' | t }}</option>
                  <option value="price-ascending">{{ 'collections.sorting.price_ascending' | t }}</option>
                  <option value="price-descending">{{ 'collections.sorting.price_descending' | t }}</option>
                  <option value="created-ascending">{{ 'collections.sorting.date_ascending' | t }}</option>
                  <option value="created-descending">{{ 'collections.sorting.date_descending' | t }}</option>
                </select>
              </div>
            {% endif %}

            <div class="product-grid__count">
              <span>{{ collection.products_count }} {{ 'collections.general.products' | t }}</span>
            </div>
          </div>
        {% endif %}

        <div
          class="product-grid__items"
          data-columns-desktop="{{ columns_desktop }}"
          data-columns-tablet="{{ columns_tablet }}"
          data-columns-mobile="{{ columns_mobile }}"
          style="
            --columns-desktop: {{ columns_desktop }};
            --columns-tablet: {{ columns_tablet }};
            --columns-mobile: {{ columns_mobile }};
          "
        >
          {% if collection.products.size > 0 %}
            {% for product in collection.products limit: products_per_page %}
              {% render 'product-card',
                product: product,
                enable_quick_view: enable_quick_view,
                show_vendor: false,
                show_badges: true
              %}
            {% endfor %}
          {% else %}
            <div class="product-grid__empty">
              <p>{{ 'collections.general.no_matches' | t }}</p>
            </div>
          {% endif %}
        </div>

        {% if collection.products.size > products_per_page %}
          <div class="product-grid__pagination">
            {% paginate collection.products by products_per_page %}
              {% if paginate.pages > 1 %}
                <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
                  {% if paginate.previous %}
                    <a href="{{ paginate.previous.url }}" class="pagination__item pagination__prev">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="12,4 6,10 12,16"></polyline>
                      </svg>
                      {{ 'general.pagination.previous' | t }}
                    </a>
                  {% endif %}

                  {% for part in paginate.parts %}
                    {% if part.is_link %}
                      <a href="{{ part.url }}" class="pagination__item">{{ part.title }}</a>
                    {% else %}
                      {% if part.title == paginate.current_page %}
                        <span class="pagination__item pagination__item--current">{{ part.title }}</span>
                      {% else %}
                        <span class="pagination__item">{{ part.title }}</span>
                      {% endif %}
                    {% endif %}
                  {% endfor %}

                  {% if paginate.next %}
                    <a href="{{ paginate.next.url }}" class="pagination__item pagination__next">
                      {{ 'general.pagination.next' | t }}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="8,4 14,10 8,16"></polyline>
                      </svg>
                    </a>
                  {% endif %}
                </nav>
              {% endif %}
            {% endpaginate %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "class": "section-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 50,
      "step": 2,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Columns (Mobile)",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable Sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_view",
      "label": "Enable Quick View",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
