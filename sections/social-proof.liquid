{% comment %}
  Social Proof Section - Original differentiation feature
  Three blocks: mini-reviews + mini-gallery + bestseller badge
{% endcomment %}

<section class="social-proof" data-section-id="{{ section.id }}" data-section-type="social-proof">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="social-proof__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="social-proof__grid">
      {%- comment -%} Block 1: Mini Reviews {%- endcomment -%}
      {% if section.settings.show_reviews %}
        <div class="social-proof__card social-proof__reviews">
          <div class="social-proof__card-inner">
            <div class="reviews__header">
              <div class="reviews__stars">
                {% for i in (1..5) %}
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" class="star">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                  </svg>
                {% endfor %}
              </div>
              <p class="reviews__rating"><strong>4.9</strong> / 5</p>
            </div>

            <div class="reviews__testimonials">
              <div class="testimonial">
                <p class="testimonial__text">"{{ section.settings.review_1_text }}"</p>
                <p class="testimonial__author">— {{ section.settings.review_1_author }}</p>
              </div>

              <div class="testimonial">
                <p class="testimonial__text">"{{ section.settings.review_2_text }}"</p>
                <p class="testimonial__author">— {{ section.settings.review_2_author }}</p>
              </div>

              <div class="testimonial">
                <p class="testimonial__text">"{{ section.settings.review_3_text }}"</p>
                <p class="testimonial__author">— {{ section.settings.review_3_author }}</p>
              </div>
            </div>

            <p class="reviews__count">Based on {{ section.settings.review_count }} reviews</p>
          </div>
        </div>
      {% endif %}

      {%- comment -%} Block 2: Mini Gallery (Customer Photos) {%- endcomment -%}
      {% if section.settings.show_gallery %}
        <div class="social-proof__card social-proof__gallery">
          <div class="social-proof__card-inner">
            <h3 class="gallery__title">{{ section.settings.gallery_title | default: '#CustomerLove' }}</h3>

            <div class="gallery__grid">
              {% if section.settings.gallery_image_1 %}
                <div class="gallery__item">
                  <img
                    src="{{ section.settings.gallery_image_1 | image_url: width: 300 }}"
                    srcset="
                      {{ section.settings.gallery_image_1 | image_url: width: 150 }} 150w,
                      {{ section.settings.gallery_image_1 | image_url: width: 300 }} 300w
                    "
                    sizes="(min-width: 768px) 150px, 100px"
                    alt="Customer photo"
                    loading="lazy"
                    class="gallery__image"
                  >
                </div>
              {% else %}
                <div class="gallery__item gallery__placeholder"></div>
              {% endif %}

              {% if section.settings.gallery_image_2 %}
                <div class="gallery__item">
                  <img
                    src="{{ section.settings.gallery_image_2 | image_url: width: 300 }}"
                    srcset="
                      {{ section.settings.gallery_image_2 | image_url: width: 150 }} 150w,
                      {{ section.settings.gallery_image_2 | image_url: width: 300 }} 300w
                    "
                    sizes="(min-width: 768px) 150px, 100px"
                    alt="Customer photo"
                    loading="lazy"
                    class="gallery__image"
                  >
                </div>
              {% else %}
                <div class="gallery__item gallery__placeholder"></div>
              {% endif %}

              {% if section.settings.gallery_image_3 %}
                <div class="gallery__item">
                  <img
                    src="{{ section.settings.gallery_image_3 | image_url: width: 300 }}"
                    srcset="
                      {{ section.settings.gallery_image_3 | image_url: width: 150 }} 150w,
                      {{ section.settings.gallery_image_3 | image_url: width: 300 }} 300w
                    "
                    sizes="(min-width: 768px) 150px, 100px"
                    alt="Customer photo"
                    loading="lazy"
                    class="gallery__image"
                  >
                </div>
              {% else %}
                <div class="gallery__item gallery__placeholder"></div>
              {% endif %}

              {% if section.settings.gallery_image_4 %}
                <div class="gallery__item">
                  <img
                    src="{{ section.settings.gallery_image_4 | image_url: width: 300 }}"
                    srcset="
                      {{ section.settings.gallery_image_4 | image_url: width: 150 }} 150w,
                      {{ section.settings.gallery_image_4 | image_url: width: 300 }} 300w
                    "
                    sizes="(min-width: 768px) 150px, 100px"
                    alt="Customer photo"
                    loading="lazy"
                    class="gallery__image"
                  >
                </div>
              {% else %}
                <div class="gallery__item gallery__placeholder"></div>
              {% endif %}
            </div>

            <p class="gallery__cta">Share your photos with <strong>{{ section.settings.gallery_hashtag | default: '#YourBrand' }}</strong></p>
          </div>
        </div>
      {% endif %}

      {%- comment -%} Block 3: Best-Selling Badge {%- endcomment -%}
      {% if section.settings.show_bestseller %}
        <div class="social-proof__card social-proof__bestseller">
          <div class="social-proof__card-inner">
            <div class="bestseller__badge">
              <svg width="60" height="60" viewBox="0 0 60 60" fill="none" class="bestseller__icon">
                <circle cx="30" cy="30" r="28" stroke="currentColor" stroke-width="2"/>
                <path d="M30 10 L35 25 L50 25 L38 35 L43 50 L30 40 L17 50 L22 35 L10 25 L25 25 Z" fill="currentColor"/>
              </svg>
            </div>

            <h3 class="bestseller__title">{{ section.settings.bestseller_title | default: 'Best Sellers' }}</h3>
            <p class="bestseller__stat">
              <strong>{{ section.settings.bestseller_number | default: '10,000+' }}</strong>
            </p>
            <p class="bestseller__description">{{ section.settings.bestseller_text | default: 'Products sold this month' }}</p>

            {% if section.settings.bestseller_products_sold %}
              <div class="bestseller__products">
                <p class="bestseller__label">Top sellers:</p>
                <ul class="bestseller__list">
                  <li>{{ section.settings.bestseller_product_1 | default: 'Premium Collection' }}</li>
                  <li>{{ section.settings.bestseller_product_2 | default: 'Essential Series' }}</li>
                  <li>{{ section.settings.bestseller_product_3 | default: 'Signature Line' }}</li>
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Proof",
  "class": "section-social-proof",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Thousands"
    },
    {
      "type": "header",
      "content": "Reviews Block"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Total Review Count",
      "default": "2,847"
    },
    {
      "type": "textarea",
      "id": "review_1_text",
      "label": "Review 1 Text",
      "default": "Exceptional quality. Every detail is perfect."
    },
    {
      "type": "text",
      "id": "review_1_author",
      "label": "Review 1 Author",
      "default": "Sarah M."
    },
    {
      "type": "textarea",
      "id": "review_2_text",
      "label": "Review 2 Text",
      "default": "Beautiful design and sustainable. Love it!"
    },
    {
      "type": "text",
      "id": "review_2_author",
      "label": "Review 2 Author",
      "default": "James L."
    },
    {
      "type": "textarea",
      "id": "review_3_text",
      "label": "Review 3 Text",
      "default": "Worth every penny. Highly recommend."
    },
    {
      "type": "text",
      "id": "review_3_author",
      "label": "Review 3 Author",
      "default": "Emily R."
    },
    {
      "type": "header",
      "content": "Gallery Block"
    },
    {
      "type": "checkbox",
      "id": "show_gallery",
      "label": "Show Gallery",
      "default": true
    },
    {
      "type": "text",
      "id": "gallery_title",
      "label": "Gallery Title",
      "default": "#CustomerLove"
    },
    {
      "type": "text",
      "id": "gallery_hashtag",
      "label": "Gallery Hashtag",
      "default": "#YourBrand"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_1",
      "label": "Gallery Image 1"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_2",
      "label": "Gallery Image 2"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_3",
      "label": "Gallery Image 3"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_4",
      "label": "Gallery Image 4"
    },
    {
      "type": "header",
      "content": "Best Seller Block"
    },
    {
      "type": "checkbox",
      "id": "show_bestseller",
      "label": "Show Best Seller",
      "default": true
    },
    {
      "type": "text",
      "id": "bestseller_title",
      "label": "Title",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "bestseller_number",
      "label": "Number/Stat",
      "default": "10,000+"
    },
    {
      "type": "text",
      "id": "bestseller_text",
      "label": "Description",
      "default": "Products sold this month"
    },
    {
      "type": "checkbox",
      "id": "bestseller_products_sold",
      "label": "Show Top Products List",
      "default": true
    },
    {
      "type": "text",
      "id": "bestseller_product_1",
      "label": "Product 1",
      "default": "Premium Collection"
    },
    {
      "type": "text",
      "id": "bestseller_product_2",
      "label": "Product 2",
      "default": "Essential Series"
    },
    {
      "type": "text",
      "id": "bestseller_product_3",
      "label": "Product 3",
      "default": "Signature Line"
    }
  ],
  "presets": [
    {
      "name": "Social Proof"
    }
  ]
}
{% endschema %}
