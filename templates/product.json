{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "trust_badges": {
          "type": "trust_badges",
          "settings": {
            "badge_1": "Free Shipping",
            "badge_2": "Secure Checkout",
            "badge_3": "Easy Returns"
          }
        },
        "tabs": {
          "type": "product_tabs",
          "settings": {
            "tab_1_title": "Description",
            "tab_2_title": "Shipping",
            "tab_2_content": "Free shipping on orders over $100. Standard delivery takes 3-5 business days.",
            "tab_3_title": "Returns",
            "tab_3_content": "30-day hassle-free returns. Items must be unused and in original packaging."
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity",
        "buy_buttons",
        "trust_badges",
        "tabs"
      ],
      "settings": {
        "enable_sticky_add_to_cart": true,
        "enable_image_zoom": true,
        "enable_video": true,
        "image_size": "large",
        "gallery_layout": "carousel"
      }
    },
    "related_products": {
      "type": "related-products",
      "settings": {
        "heading": "You May Also Like",
        "products_to_show": 4,
        "columns": 4
      }
    }
  },
  "order": [
    "main",
    "related_products"
  ]
}
