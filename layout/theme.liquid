<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- liquid
    assign formatted_initial_value = cart.total_price | money_without_trailing_zeros | strip_html
    assign formatted_placeholder = 'cart.label.total' | t | strip_html
  -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  <!-- Critical CSS - Inlined for performance -->
  <style>
    /* Critical CSS for above-the-fold content */
    :root {
      --color-bg: #FAFBFB;
      --color-text: #111827;
      --color-accent: #2C5F7D;
      --color-accent-alt: #C7705C;
      --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
      --font-heading: var(--font-body);
      --spacing-unit: 1rem;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-body);
      color: var(--color-text);
      background-color: var(--color-bg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>

  {{ content_for_header }}

  <!-- Deferred CSS -->
  <link rel="preload" href="{{ 'styles.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="{{ 'styles.css' | asset_url }}"></noscript>

  <!-- Preconnect to required domains -->
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {%- if request.page_type == 'product' -%}
    <!-- JSON-LD Product Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "image": {{ product.featured_image | image_url: width: 1200 | json }},
      "description": {{ product.description | strip_html | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ shop.name | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": {{ product.url | within: collections.all | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | divided_by: 100.0 | json }},
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
      }
    }
    </script>
  {%- endif -%}
</head>

<body class="template-{{ request.page_type }}">
  <a class="sr-only" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {% section 'header' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <!-- Cart Drawer -->
  <div id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}" hidden>
    <div class="cart-drawer__overlay"></div>
    <div class="cart-drawer__content">
      <div class="cart-drawer__header">
        <h2>{{ 'cart.general.title' | t }} (<span class="cart-count">{{ cart.item_count }}</span>)</h2>
        <button type="button" class="cart-drawer__close" aria-label="{{ 'accessibility.close' | t }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="cart-drawer__items" id="cart-items">
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}
            <div class="cart-item" data-line-item="{{ forloop.index }}">
              <div class="cart-item__image">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" loading="lazy">
                {% endif %}
              </div>
              <div class="cart-item__details">
                <h3 class="cart-item__title">{{ item.product.title }}</h3>
                {% if item.variant.title != 'Default Title' %}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {% endif %}
                <div class="cart-item__quantity">
                  <button type="button" class="qty-btn" data-action="decrease" data-line="{{ forloop.index }}" aria-label="{{ 'cart.general.decrease_quantity' | t }}">−</button>
                  <input type="number" value="{{ item.quantity }}" min="0" class="qty-input" data-line="{{ forloop.index }}" aria-label="{{ 'cart.general.quantity' | t }}">
                  <button type="button" class="qty-btn" data-action="increase" data-line="{{ forloop.index }}" aria-label="{{ 'cart.general.increase_quantity' | t }}">+</button>
                </div>
              </div>
              <div class="cart-item__price">
                <span class="money">{{ item.final_line_price | money }}</span>
                <button type="button" class="cart-item__remove" data-line="{{ forloop.index }}" aria-label="{{ 'cart.general.remove' | t }}">
                  {{ 'cart.general.remove' | t }}
                </button>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <p class="cart-empty">{{ 'cart.general.empty' | t }}</p>
        {% endif %}
      </div>

      {% if cart.item_count > 0 %}
        <div class="cart-drawer__footer">
          <div class="cart-subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span class="money cart-subtotal__price">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-note">{{ 'cart.general.taxes_and_shipping' | t }}</p>
          <a href="/cart" class="btn btn--secondary btn--full">{{ 'cart.general.view_cart' | t }}</a>
          <button type="submit" class="btn btn--primary btn--full" onclick="window.location='/checkout'">
            {{ 'cart.general.checkout' | t }}
          </button>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Quick View Modal -->
  <div id="quick-view-modal" class="modal" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}" hidden>
    <div class="modal__overlay"></div>
    <div class="modal__content">
      <button type="button" class="modal__close" aria-label="{{ 'accessibility.close' | t }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div id="quick-view-content"></div>
    </div>
  </div>
</body>
</html>
